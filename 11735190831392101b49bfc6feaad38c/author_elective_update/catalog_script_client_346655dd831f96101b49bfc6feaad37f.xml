        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return; // Evita execução ao carregar o formulário ou se o campo estiver vazio
    }

    // Remove mensagens de erro anteriores
    g_form.hideFieldMsg(control);

    // Converte a data inserida para um objeto Date
    var inputDate = new Date(newValue);

    // Verifica se a data inserida é válida
    if (isNaN(inputDate.getTime())) {
        g_form.showFieldMsg(control, 'Data inválida. Por favor, insira uma data válida.', 'error');
        g_form.setValue(control, ''); // Limpa o campo
        return;
    }

    // Obtém a data atual no formato ISO e ajusta para o início do dia
    var currentDate = new Date();
    currentDate.setHours(0, 0, 0, 0); // Define a hora como 00:00:00

    // Compara a data inserida com a data atual
    if (inputDate > currentDate) {
        g_form.showFieldMsg(control, 'A data não pode ser maior que a data atual.', 'error');
        g_form.setValue(control, ''); // Limpa o campo
    }
}]]></script>
