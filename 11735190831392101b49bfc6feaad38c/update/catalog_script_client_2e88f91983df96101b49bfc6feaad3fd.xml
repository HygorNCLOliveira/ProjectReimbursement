        <name>Validate expense date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return; // Não executa se o formulário estiver carregando ou o campo estiver vazio
    }

    // Obter a data atual
    var today = new Date();
    today.setHours(0, 0, 0, 0); // Ajusta para ignorar a hora

    // Converter o valor da variável expense_date para um objeto Date
    var expenseDate = new Date(newValue);

    // Verificar se a data inserida é maior ou igual à data atual
    if (expenseDate >= today) {
        g_form.showFieldMsg('expense_date', 'A data deve ser anterior à data atual.', 'error'); // Mostra a mensagem de erro
        g_form.setValue('expense_date', 'The date must be before the current date'); // Limpa o campo para forçar o usuário a inserir uma nova data
    } else {
        g_form.hideFieldMsg('expense_date'); // Remove a mensagem de erro, se existir
    }
}]]></script>
