        <name>Validate expense date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }

    var today = new Date();
    today.setHours(0, 0, 0, 0); 

    var expenseDate = new Date(newValue);

    if (expenseDate >= today) {
        g_form.showFieldMsg('expense_date', 'A data deve ser anterior à data atual.', 'error');
        g_form.setValue('expense_date', 'The date must be before the current date'); 
    } else {
        g_form.hideFieldMsg('expense_date');
    }
}]]></script>
