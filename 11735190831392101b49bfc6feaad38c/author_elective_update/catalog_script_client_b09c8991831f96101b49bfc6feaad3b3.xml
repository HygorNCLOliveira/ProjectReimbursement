        <name>validation date</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) {
        return;
    }

    try {
        // Obtém a data atual e remove as horas para comparar apenas a data
        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);

        // Converte o valor do campo (newValue) em um objeto Date
        var inputDate = new Date(newValue);

        // Verifica se o valor inserido é inválido
        if (isNaN(inputDate)) {
            g_form.showFieldMsg(control, 'A data inserida não é válida.', 'error');
            g_form.setValue(control, '');
            return;
        }

        // Compara as datas: inputDate não pode ser maior que currentDate
        if (inputDate > currentDate) {
            g_form.showFieldMsg(control, 'A data não pode ser maior que a data atual.', 'error');
            g_form.setValue(control, '');
        } else {
            g_form.hideFieldMsg(control); // Remove mensagens de erro, caso existam
        }
    } catch (e) {
        // Exibe erros inesperados no console
        g_form.hideFieldMsg('Erro ao validar a data:', e);
    }
}]]></script>
